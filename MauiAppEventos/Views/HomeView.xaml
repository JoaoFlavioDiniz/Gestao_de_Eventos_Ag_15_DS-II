<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MauiAppEventos.Services"
             x:Class="MauiAppEventos.Views.HomeView"
             Title="Início"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="580" HorizontalOptions="Fill">

            <!-- Cabeçalho de Boas-Vindas -->
            <Border Stroke="#BFDBFE"
                    StrokeThickness="1"
                    BackgroundColor="#EFF6FF"
                    Padding="22"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="📅" FontSize="38" HorizontalOptions="Center" />
                    <Label Text="Gestão de Eventos"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A"
                           HorizontalOptions="Center" />
                    <Label Text="Planeje seus eventos, calcule a duração automaticamente e mantenha seus eventos salvos durante a sessão."
                           FontSize="14"
                           TextColor="#475569"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Botão Principal de Cadastro -->
            <Button Text="+ Cadastrar Novo Evento"
                    Clicked="OnIrParaCadastroClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="8" />

            <!-- Lista de Eventos Salvos temporariamente na Memória -->
            <Border Stroke="#E2E8F0"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="18"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">
                    <Label Text="EVENTOS SALVOS NESTA SESSÃO"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#64748B" />
                    
                    <!--Exibe a lista de eventos cadastrados-->
                    <CollectionView x:Name="ListaEventosCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnEventoSelecionado">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum evento cadastrado ainda. Clique no botão acima para criar o primeiro!"
                                   FontSize="14"
                                   TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,15" />
                        </CollectionView.EmptyView>

                         <!--Exibe cada evento na lista-->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        Padding="14"
                                        Margin="0,0,0,8"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="{Binding Local, StringFormat='Local: {0}'}" FontSize="13" TextColor="#475569" />
                                            <Label Text="{Binding DataInicio, StringFormat='Data: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                            <Label Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#15803D"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding DuracaoDias, StringFormat='{0} dia(s)'}"
                                                   FontSize="12"
                                                   TextColor="#2563EB"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Rodapé Informativo da agenda 15 -->
            <Label Text=".NET MAUI 10 • Arquitetura MVVM - Agenda 15"
                   FontSize="12"
                   TextColor="#94A3B8"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
